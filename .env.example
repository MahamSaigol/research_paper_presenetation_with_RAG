# Which ingestion source to use. local_folder (default) reads PDFs from a
# local directory. graph_api pulls them from OneDrive via Microsoft Graph —
# only switch to this if you have an Azure account/tenant where app
# registration isn't blocked (see README).
INGESTION_SOURCE=local_folder

# --- local_folder mode ---
# Folder containing your literature-review PDFs.
LOCAL_PAPERS_DIR=./papers

# --- graph_api mode (ignored unless INGESTION_SOURCE=graph_api) ---
GRAPH_CLIENT_ID=
GRAPH_TENANT=common
GRAPH_SCOPES=Files.Read
ONEDRIVE_PAPERS_FOLDER=Thesis/Literature
TOKEN_CACHE_PATH=.token_cache.bin
